# =============================================================================
# The 60-Second AI Leadership Challenge — environment variables
# =============================================================================
#
# HOW TO USE THIS FILE
#   1. Make a copy of it named ".env.local"  (that file is git-ignored and holds your real values).
#         cp .env.example .env.local
#   2. Fill in every value below.
#   3. Restart the dev server after any change.
#
# RULE: never add the prefix NEXT_PUBLIC_ to a secret. Anything starting with NEXT_PUBLIC_ is
#       compiled into the JavaScript that the visitor's browser downloads and is therefore public.
# =============================================================================


# --- Supabase (the database) -------------------------------------------------

# Your Supabase project URL.
# Where to find it: supabase.com -> your project -> Project Settings -> Data API -> "Project URL".
# Looks like: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Your Supabase server-side secret key. SERVER ONLY — never share it, never commit it.
# Where to find it: Project Settings -> API Keys -> "Secret keys" (previously called the
# "service_role" key). Click "Reveal" and copy it.
# If this leaks, rotate it immediately in the Supabase dashboard.
SUPABASE_SECRET_KEY=


# --- Public application URL --------------------------------------------------

# The address people type or scan to reach the challenge. This is what the QR code encodes.
# Local development: http://localhost:3000
# Production example: https://challenge.outskill.com
# No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- Admin access ------------------------------------------------------------

# The shared username booth staff type at /admin. One account is shared by the whole booth team;
# every signed-in admin has every permission, and the audit log records the shared identity plus a
# per-session id rather than a person.
ADMIN_USERNAME=outskill-admin

# The password booth staff type at /admin. Choose something long and random.
# Generate one:   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PASSWORD=

# Secret used to sign the admin login cookie. Minimum 32 characters.
# Generate one:   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this value logs every admin out immediately.
ADMIN_SESSION_SECRET=


# --- Challenge integrity -----------------------------------------------------

# Secret used to sign participant and attempt tokens so nobody can forge a challenge run.
# Minimum 32 characters. Generate the same way as above.
# Changing this during the event invalidates challenges that are in progress.
ATTEMPT_SIGNING_SECRET=

# Secret mixed into the one-way hash of visitor IP addresses. Minimum 32 characters.
# Raw IP addresses are never stored — only this salted hash, used for abuse thresholds.
IP_HASH_SECRET=


# --- Event configuration -----------------------------------------------------

# Timezone used for event day boundaries and admin timestamps.
EVENT_TIMEZONE=Asia/Kolkata


# --- Optional: demo / preview mode ------------------------------------------
#
# Set DEMO_MODE=1 to run the whole app against an in-memory store filled with obviously fake data,
# so you can look at every screen before Supabase is set up. A "DEMO MODE" badge appears on screen.
# NEVER set this in production — the app refuses to start in production with DEMO_MODE on.
# Leave it blank or remove the line for real events.
DEMO_MODE=

# Optional: admin password used only while DEMO_MODE=1, so you can preview the admin screens
# without setting a real one. Ignored outside demo mode. Defaults to "demo-admin".
DEMO_ADMIN_PASSWORD=


# --- Optional: branding ------------------------------------------------------
#
# Set to 1 once you have placed the official Outskill logo at public/outskill-logo.svg.
# Until then the app shows a clean text wordmark. See public/README.md.
# This one is intentionally public — it controls presentation only and holds no secret.
NEXT_PUBLIC_HAS_OFFICIAL_LOGO=
